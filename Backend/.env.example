# 複製為 .env 後填入（.env 已列入 .gitignore，只存在 NAS 上）
PORT=8080

# TDX 會員中心 > 資料服務 > API 金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# TDX 會員中心「資料存取金鑰」（MQTT 用）；留空則異常消息改用 REST 輪詢
TDX_MQTT_CLIENT_ID=
TDX_MQTT_USERNAME=
TDX_MQTT_PASSWORD=

# App 呼叫本服務的金鑰（至少 24 字元）；產生方式：openssl rand -hex 24
APP_API_KEY=

CITIES=Taipei,NewTaipei,Keelung,Taoyuan,Taichung,Kaohsiung
DATA_DIR=/data
